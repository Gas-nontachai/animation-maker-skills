    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "@xmldom/xmldom": "0.8.15"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
