{
  "name": "@gas-nontachai/animation-maker",
  "version": "1.0.0",
  "description": "Local-first data-driven SVG animation skills and runtime",
  "scripts": {
    "validate": "node --import tsx scripts/validate.ts",
    "render": "node --import tsx scripts/render.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:integration": "node --import tsx scripts/smoke.ts",
    "doctor": "node bin/animation-maker.mjs doctor",
    "test:package": "node --import tsx scripts/package-smoke.ts"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.373",
    "@remotion/renderer": "4.0.373",
    "remotion": "4.0.373",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "@xmldom/xmldom": "0.8.15",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "bin": {
    "animation-maker": "bin/animation-maker.mjs"
  },
  "files": [
    "bin/",
    "scripts/project.ts",
    "scripts/validate.ts",
    "scripts/render.ts",
    "scripts/doctor.ts",
    "scripts/environment.ts",
    "packages/animation-runtime/src/",
    "renderer/src/",
    "examples/waving-character/",
    "skills/",
    "tsconfig.json"
  ]
}
