{
  "name": "@gasnonthachai/animation-maker",
  "version": "1.1.0",
  "description": "Local-first data-driven SVG animation skills and runtime",
  "scripts": {
    "validate": "node --import tsx scripts/validate.ts",
    "render": "node --import tsx scripts/render.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:integration": "node --import tsx scripts/smoke.ts",
    "doctor": "node bin/animation-maker.mjs doctor",
    "test:package": "node --import tsx scripts/package-smoke.ts",
    "test:release": "node --import tsx scripts/release-smoke.ts",
    "security:check": "node scripts/security-gate.mjs"
  },
  "license": "MIT",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@xmldom/xmldom": "0.8.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "bin": {
    "animation-maker": "bin/animation-maker.mjs"
  },
  "files": [
    "bin/",
    "scripts/project.ts",
    "scripts/validate.ts",
    "scripts/render.ts",
    "scripts/doctor.ts",
    "scripts/environment.ts",
    "packages/animation-runtime/src/",
    "renderer/src/",
    "examples/waving-character/",
    "skills/",
    "tsconfig.json",
    "scripts/create.ts",
    "scripts/wave.ts",
    "scripts/inspect.ts",
    "docs/asset-contract.md",
    "docs/security-phase1.7.md",
    "docs/phase1.7-verification.md",
    "docs/release-pipeline.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Gas-nontachai/animation-maker-skills.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "zod": "$zod"
  }
}
